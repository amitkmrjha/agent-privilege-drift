# Copy to .env and fill in. Never commit a real .env (it is gitignored).

# Frontier arm (only needed when the frontier model is run). Set the key for the
# provider named in configs/models.yaml.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Where Ollama listens. Defaults to http://localhost:11434 when unset.
# From inside Docker on a Mac use http://host.docker.internal:11434
OLLAMA_API_BASE=
